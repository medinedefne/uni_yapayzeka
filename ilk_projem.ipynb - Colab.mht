.gb_C::before, .gb_Rd button::before { background: var(--gm3-sys-color-on-surface-variant,#444746); border-radius: 100px; content: " "; height: 100%; left: 0px; opacity: 0; position: absolute; top: 0px; transition: opacity 0.3s ease-out; width: 100%; }

.gb_Rd button::before { height: 40px; left: 8px; top: 4px; width: 40px; }

.gb_Ta.gb_K .gb_C::before, .gb_Ta.gb_K .gb_Rd button::before { --gm3-sys-color-on-surface-variant: #c4c7c5; --gm3-sys-color-on-surface-variant-rgb: 196,199,197; background: var(--gm3-sys-color-on-surface-variant,#444746); }

.gb_C:active, .gb_C:focus:not(:focus-visible), .gb_C:hover, .gb_C[aria-expanded="true"], .gb_Rd button:active svg, .gb_Rd button:focus:not(:focus-visible) svg, .gb_Rd button:hover svg { outline: none; }

.gb_C:focus-visible, .gb_Rd button:focus-visible svg { outline-style: solid; outline-width: 1px; outline-offset: 0px; outline-color: var(--gm3-sys-color-primary,#0b57d0); }

.gb_C.gb_W::before { border-radius: 50%; height: auto; inset: -4px; width: auto; }

.gb_C.gb_W:hover::before { opacity: 0.1; }

.gb_Ta.gb_K .gb_C:focus-visible, .gb_Ta.gb_K .gb_Rd button:focus-visible svg { --gm3-sys-color-primary: #a8c7fa; --gm3-sys-color-primary-rgb: 168,199,250; outline-color: var(--gm3-sys-color-primary,#0b57d0); }

