.gb_C:active::before, .gb_Rd button:active::before { opacity: 0.16; }

.gb_C:hover::before, .gb_Rd button:hover::before { opacity: 0.08; }

.gb_9a .gb_C.gb_bb:hover::before { opacity: 0; }

.gb_C:hover[aria-expanded="true"]::before, .gb_C[aria-expanded="true"]::before { opacity: 0.16; }

.gb_C::after { content: ""; position: absolute; inset: -4px; }

